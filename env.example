# Configuration PostgreSQL (Docker local)
# Pour utiliser Docker : docker-compose up -d
# Puis utilisez ces valeurs :

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gei_bi_platform

# OU utilisez DIRECT_URL (recommandé)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/gei_bi_platform

# Environnement
NODE_ENV=development
PORT=3000
